<idea-plugin>
    <id>com.claudecode.jetbrains</id>
    <name>Better Claude Code</name>
    <vendor>Better Claude Code Contributors</vendor>

    <description><![CDATA[
<p>A native JetBrains IDE interface for <b>Claude Code</b> — Anthropic's AI coding assistant on the command line.</p>

<p>This plugin brings the full Claude Code experience into IntelliJ IDEA, WebStorm, PyCharm, and other JetBrains IDEs with a rich, native UI.</p>

<h3>Features</h3>
<ul>
    <li><b>Chat panel</b> — Stream conversations with Claude directly in your IDE, with full Markdown rendering and syntax highlighting</li>
    <li><b>Inline diffs</b> — Review Claude's code changes in JetBrains' native diff viewer before accepting</li>
    <li><b>Permission system</b> — Approve or deny file edits, command execution, and other tool use</li>
    <li><b>Session management</b> — Continue previous conversations, manage multiple sessions, and restore context</li>
    <li><b>Checkpoints</b> — Snapshot and rewind your project state at any point during a conversation</li>
    <li><b>Slash commands</b> — Use /init, /compact, /review, /doctor, and more directly from the chat</li>
    <li><b>File mentions</b> — Reference files with @file syntax for precise context</li>
    <li><b>IDE-aware context</b> — Automatically feeds IntelliJ's diagnostics (type errors, inspections, warnings) to Claude with every message — context the CLI alone cannot access</li>
    <li><b>Fix All Errors</b> — One-click action to send all errors across open files to Claude for batch fixing</li>
    <li><b>Editor integration</b> — Right-click to ask Claude, fix errors, refactor, generate tests, or explain code</li>
    <li><b>MCP server support</b> — Manage Model Context Protocol servers and plugins</li>
    <li><b>Keyboard shortcuts</b> — Cmd/Ctrl+Esc to toggle the panel, Cmd/Ctrl+Shift+Esc for a new tab</li>
</ul>

<h3>Requirements</h3>
<ul>
    <li><a href="https://docs.anthropic.com/en/docs/claude-code/overview">Claude Code CLI</a> must be installed and authenticated</li>
</ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <backgroundPostStartupActivity implementation="com.claudecode.jetbrains.ClaudeCodePlugin"/>
        <notificationGroup id="Better Claude Code Notifications"
                           displayType="BALLOON"
                           toolWindowId="Better Claude Code"/>
        <applicationService serviceImplementation="com.claudecode.jetbrains.settings.ClaudeSettings"/>
        <applicationConfigurable
            parentId="tools"
            instance="com.claudecode.jetbrains.ui.settings.ClaudeSettingsConfigurable"
            id="com.claudecode.jetbrains.settings"
            displayName="Better Claude Code"/>
        <projectService serviceImplementation="com.claudecode.jetbrains.cli.ClaudeCliManager"/>
        <projectService serviceImplementation="com.claudecode.jetbrains.cli.SessionManager"/>
        <projectService serviceImplementation="com.claudecode.jetbrains.context.DiagnosticsProvider"/>
        <projectService serviceImplementation="com.claudecode.jetbrains.context.FileContextProvider"/>
        <projectService serviceImplementation="com.claudecode.jetbrains.context.ProjectContextProvider"/>
        <projectService serviceImplementation="com.claudecode.jetbrains.context.GitBranchTracker"/>
        <projectService serviceImplementation="com.claudecode.jetbrains.context.TerminalContextProvider"/>
        <projectService serviceImplementation="com.claudecode.jetbrains.context.GitContextProvider"/>
        <projectService serviceImplementation="com.claudecode.jetbrains.context.IdeContextAggregator"/>
        <projectService serviceImplementation="com.claudecode.jetbrains.services.ClaudeStateService"/>
        <projectService serviceImplementation="com.claudecode.jetbrains.ui.sessions.SessionTabManager"/>
        <projectService serviceImplementation="com.claudecode.jetbrains.checkpoint.CheckpointManager"/>
        <fileEditorProvider
            implementation="com.claudecode.jetbrains.ui.sessions.ClaudeEditorProvider"/>
        <statusBarWidgetFactory
            id="ClaudeCode.StatusBar"
            implementation="com.claudecode.jetbrains.ui.ClaudeStatusBarWidgetFactory"
            order="after encodingWidget"/>
        <toolWindow id="Better Claude Code"
                    anchor="right"
                    icon="/icons/claude.svg"
                    factoryClass="com.claudecode.jetbrains.ui.chat.ChatToolWindowFactory"/>
    </extensions>

    <actions>
        <group id="ClaudeCode.ToolsMenu" text="Better Claude Code" popup="true"
               icon="/icons/claude.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="ClaudeCode.Open"
                    class="com.claudecode.jetbrains.actions.OpenClaudeAction"
                    text="Open Better Claude Code"
                    description="Open the Better Claude Code panel"
                    icon="/icons/claude.svg"/>
            <action id="ClaudeCode.OpenInNewTab"
                    class="com.claudecode.jetbrains.actions.OpenInNewTabAction"
                    text="Better Claude Code: Open in New Tab"
                    description="Open a new Better Claude Code conversation in an editor tab"
                    icon="/icons/claude.svg"/>
            <action id="ClaudeCode.OpenInNewWindow"
                    class="com.claudecode.jetbrains.actions.OpenInNewWindowAction"
                    text="Better Claude Code: Open in New Window"
                    description="Open Better Claude Code in a separate window"
                    icon="/icons/claude.svg"/>
            <action id="ClaudeCode.FixAllErrorsMenu"
                    class="com.claudecode.jetbrains.actions.FixAllErrorsAction"
                    text="Fix All Errors"
                    description="Send all errors across open files to Claude for fixing"
                    icon="/icons/claude.svg"/>
        </group>
        <action id="ClaudeCode.ToggleFocus"
                class="com.claudecode.jetbrains.actions.ToggleFocusAction"
                text="Toggle Better Claude Code Panel"
                description="Toggle focus between editor and Better Claude Code panel">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl ESCAPE"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta ESCAPE"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta ESCAPE"/>
        </action>
        <action id="ClaudeCode.OpenInNewTabShortcut"
                class="com.claudecode.jetbrains.actions.OpenInNewTabAction"
                text="Open Better Claude Code in New Tab"
                description="Open a new Better Claude Code conversation in an editor tab">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="ctrl shift ESCAPE"/>
            <keyboard-shortcut keymap="Mac OS X"
                               first-keystroke="meta shift ESCAPE"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+"
                               first-keystroke="meta shift ESCAPE"/>
        </action>
        <action id="ClaudeCode.InsertFileRef"
                class="com.claudecode.jetbrains.actions.InsertFileRefAction"
                text="Insert File Reference in Claude"
                description="Insert @file#line reference into Better Claude Code prompt">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt K"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt K"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt K"/>
        </action>
        <action id="ClaudeCode.NewConversation"
                class="com.claudecode.jetbrains.actions.NewConversationAction"
                text="Better Claude Code: New Conversation"
                description="Start a new conversation in the current Better Claude Code panel">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl N"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta N"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta N"/>
        </action>

        <!-- Editor right-click context menu actions -->
        <group id="ClaudeCode.EditorPopupMenu" text="Better Claude Code" popup="true"
               icon="/icons/claude.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <action id="ClaudeCode.AskClaude"
                    class="com.claudecode.jetbrains.actions.AskClaudeAction"
                    text="Ask Claude About This"
                    description="Ask Claude about the selected code"
                    icon="/icons/claude.svg"/>
            <action id="ClaudeCode.FixError"
                    class="com.claudecode.jetbrains.actions.FixErrorAction"
                    text="Fix This Error with Claude"
                    description="Send error context to Claude for fixing"
                    icon="/icons/claude.svg"/>
            <action id="ClaudeCode.Refactor"
                    class="com.claudecode.jetbrains.actions.RefactorAction"
                    text="Refactor with Claude"
                    description="Ask Claude to refactor the selected code"
                    icon="/icons/claude.svg"/>
            <action id="ClaudeCode.GenerateTests"
                    class="com.claudecode.jetbrains.actions.GenerateTestsAction"
                    text="Generate Tests with Claude"
                    description="Ask Claude to generate unit tests"
                    icon="/icons/claude.svg"/>
            <action id="ClaudeCode.ExplainCode"
                    class="com.claudecode.jetbrains.actions.ExplainCodeAction"
                    text="Explain This Code"
                    description="Ask Claude to explain the selected code"
                    icon="/icons/claude.svg"/>
            <action id="ClaudeCode.DocumentCode"
                    class="com.claudecode.jetbrains.actions.DocumentCodeAction"
                    text="Add Documentation with Claude"
                    description="Ask Claude to add documentation comments"
                    icon="/icons/claude.svg"/>
            <action id="ClaudeCode.FixAllErrors"
                    class="com.claudecode.jetbrains.actions.FixAllErrorsAction"
                    text="Fix All Errors with Claude"
                    description="Send all errors across open files to Claude for fixing"
                    icon="/icons/claude.svg"/>
        </group>
    </actions>
</idea-plugin>
